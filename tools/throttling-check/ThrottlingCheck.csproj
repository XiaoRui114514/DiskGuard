<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DiskGuard.Core/DiskGuard.Core.csproj" Aliases="production" />
    <!-- Run the production throttler against a deterministic managed Win32 substitute. -->
    <Compile Include="../../src/DiskGuard.Core/Throttling/ProcessThrottler.cs" Link="ProcessThrottler.cs" />
    <Compile Include="../../src/DiskGuard.Core/Throttling/ThrottleHandle.cs" Link="ThrottleHandle.cs" />
  </ItemGroup>
</Project>
