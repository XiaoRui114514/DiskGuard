<Window x:Class="DiskGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘守护 DiskGuard" Height="760" Width="1100" MinHeight="640" MinWidth="960"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F5F9"
        WindowStartupLocation="CenterScreen" Closing="OnWindowClosing">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="170" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部状态卡 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="14,14,14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="监控磁盘" Foreground="#6B7280" FontSize="12" />
                    <ComboBox x:Name="DiskCombo" Width="200" Margin="0,6,0,0"
                              DisplayMemberPath="DisplayName" SelectionChanged="OnDiskChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BusyText" Text="--" FontSize="40" FontWeight="SemiBold" Foreground="#1F2937" />
                        <TextBlock Text="磁盘忙率" Margin="10,0,0,8" Foreground="#6B7280" VerticalAlignment="Bottom" />
                        <Border x:Name="StateBadge" Margin="24,0,0,10" Padding="10,4" CornerRadius="12" Background="#E8F1FF" VerticalAlignment="Bottom">
                            <TextBlock x:Name="StateText" Text="监控中" Foreground="#1D4ED8" />
                        </Border>
                    </StackPanel>
                    <ProgressBar x:Name="BusyBar" Height="10" Margin="0,6,120,0" Maximum="100" Foreground="#2563EB" Background="#E5E7EB" />
                    <TextBlock x:Name="DetailText" Margin="0,8,0,0" Foreground="#6B7280" Text="队列 -- · 读 -- · 写 --" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="230">
                    <TextBlock x:Name="TargetText" Text="当前未限速" Foreground="#374151" TextAlignment="Right" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="PauseButton" Content="暂停监控" Width="100" Height="30" Click="OnPauseClicked" />
                        <Button Content="立即还原" Width="100" Height="30" Margin="8,0,0,0" Click="OnReleaseClicked" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="#EDF0F6" BorderBrush="#E3E7EF" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#6B7280" Margin="12,0,0,0" />
                <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="以管理员身份重启" Padding="8,2" Margin="12,4,0,4"
                        VerticalAlignment="Center" Click="OnElevateClicked" />
                <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="打开配置目录" Padding="8,2" Margin="12,4,0,4"
                        VerticalAlignment="Center" Click="OnOpenFolderClicked" />
                <TextBlock x:Name="PrivilegeText" VerticalAlignment="Center" Foreground="#4B5563" Text="权限：--" />
            </DockPanel>
        </Border>

        <TabControl Margin="14,12,14,12">
            <TabItem Header="进程与限速">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,4,0,8" Foreground="#6B7280"
                               Text="按「磁盘占用」排序（该进程让磁盘忙碌的时间占比，每秒刷新）。带「已限速」标记的是被降速的进程。" />

                    <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="28"
                              Background="White" BorderBrush="#E3E7EF" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="230" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                            <DataGridTextColumn Header="磁盘占用" Binding="{Binding OccupancyText}" Width="100" />
                            <DataGridTextColumn Header="合计" Binding="{Binding RateText}" Width="120" />
                            <DataGridTextColumn Header="读" Binding="{Binding ReadText}" Width="120" />
                            <DataGridTextColumn Header="写" Binding="{Binding WriteText}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Tag}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="立即限速选中进程" Click="OnManualThrottleClicked" />
                        <Button Content="解除当前限速" Margin="8,0,0,0" Click="OnReleaseClicked" />
                        <Button Content="加入保护名单" Margin="8,0,0,0" Click="OnWhitelistAddClicked" />
                        <Button Content="移出保护名单" Margin="8,0,0,0" Click="OnWhitelistRemoveClicked" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="触发条件" />
                                <TextBlock Margin="0,0,0,8" Foreground="#6B7280" TextWrapping="Wrap"
                                           Text="当监控磁盘的忙率持续高于触发阈值时，程序会限速当前占用最高的可限速进程；忙率回落到恢复阈值后自动还原。" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="触发忙率阈值（%）" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="需持续（秒）" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="恢复忙率阈值（%）" />
                                    <TextBox Width="90" Text="{Binding Settings.RecoverPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="恢复需持续（秒）" />
                                    <TextBox Width="90" Text="{Binding Settings.RecoverSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="触发磁盘占用（%）" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerOccupancyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="该进程让磁盘忙碌的时间占比达到此值才限速" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="目标磁盘占用（%）" />
                                    <TextBox Width="90" Text="{Binding Settings.TargetOccupancyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="限速目标：把它的占用压到这个值以下" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="最小 IO 次数（次/秒）" />
                                    <TextBox Width="90" Text="{Binding Settings.MinIops, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="低于该活动量视为噪音，不动手" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="紧急保护（忙率 ≥ 该值立即限速）" />
                                    <CheckBox IsChecked="{Binding Settings.EnableEmergencyThrottle}" />
                                    <TextBox Width="70" Margin="10,0,0,0" Text="{Binding Settings.EmergencyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="秒级响应，用于防止突然卡死未响应（推荐 98）" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="限速手段" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="降低磁盘 IO 优先级" />
                                    <CheckBox IsChecked="{Binding Settings.LowerIoPriority}" />
                                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="等级：" />
                                    <ComboBox Width="120" SelectedIndex="{Binding Settings.IoPriorityLevel}">
                                        <ComboBoxItem Content="极低（推荐）" />
                                        <ComboBoxItem Content="低" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="同时降低 CPU 优先级" />
                                    <CheckBox IsChecked="{Binding Settings.LowerCpuPriority}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="启用磁盘吞吐上限" />
                                    <CheckBox IsChecked="{Binding Settings.EnableRateCap}" />
                                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="上限（MB/s）：" />
                                    <TextBox Width="90" Text="{Binding Settings.RateCapMBps, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="升级到上限前等待（秒）" />
                                    <TextBox Width="90" Text="{Binding Settings.EscalateSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="一级限速无效时才会升级" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="强力模式（间歇挂起）" />
                                    <CheckBox IsChecked="{Binding Settings.EnableSuspendMode}" />
                                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="运行(ms)：" />
                                    <TextBox Width="70" Text="{Binding Settings.SuspendRunMs, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="挂起(ms)：" />
                                    <TextBox Width="70" Text="{Binding Settings.SuspendPauseMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Margin="170,2,0,0" Foreground="#B45309" TextWrapping="Wrap"
                                           Text="提示：强力模式效果最明显，但被限速的程序会出现短暂无响应，默认关闭。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="保护设置" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="保护前台程序" />
                                    <CheckBox IsChecked="{Binding Settings.ProtectForeground}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="前台程序不会被限速" />
                                </StackPanel>
                                <TextBlock Margin="0,10,0,4" Foreground="#374151" Text="保护名单（每行一个进程名，例如 chrome.exe；支持 .exe 省略）" />
                                <TextBox Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Settings.WhitelistText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="程序行为" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="开机自动启动（管理员）" />
                                    <CheckBox x:Name="AutoStartCheck" IsChecked="{Binding Settings.AutoStart}" Click="OnAutoStartClicked" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" Text="创建计划任务，登录后静默启动" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="启动时最小化到托盘" />
                                    <CheckBox IsChecked="{Binding Settings.StartMinimized}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="写入日志文件" />
                                    <CheckBox IsChecked="{Binding Settings.WriteLogFile}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="限速时显示气泡提示" />
                                    <CheckBox IsChecked="{Binding Settings.ShowBalloon}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="保存设置" Padding="20,6" Click="OnSaveSettingsClicked" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8" />
                            <Button Content="恢复默认设置" Margin="10,0,0,0" Click="OnResetSettingsClicked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="日志">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="LogList" Grid.Row="0" ItemsSource="{Binding Logs}" Background="White"
                              BorderBrush="#E3E7EF" BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="级别" Width="70" DisplayMemberBinding="{Binding Level}" />
                                <GridViewColumn Header="内容" Width="820" DisplayMemberBinding="{Binding Message}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="清空日志" Click="OnClearLogClicked" />
                        <Button Content="打开日志目录" Margin="8,0,0,0" Click="OnOpenFolderClicked" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
