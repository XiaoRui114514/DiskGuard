<Window x:Class="DiskGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskGuard.App.Localization"
        Title="DiskGuard" Height="760" Width="1100" MinHeight="640" MinWidth="960"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#F3F5F9"
        WindowStartupLocation="CenterScreen" Closing="OnWindowClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D7DCE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#253047" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="13" Background="#D6DBE4" />
                            <Border x:Name="FocusRing" Margin="-2" CornerRadius="15" BorderBrush="#93C5FD" BorderThickness="2" Opacity="0" />
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleRow" TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" CornerRadius="7" Padding="8,7" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" ContentSource="Content" RecognizesAccessKey="True" />
                                <Grid Grid.Column="1" Width="46" Height="26" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="13" Background="#D6DBE4" />
                                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="15" BorderBrush="#93C5FD" BorderThickness="2" Opacity="0" />
                                    <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTransform" X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D7DCE5" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部状态卡 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="14,14,14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="{Binding [LabelMonitorDisk], Source={x:Static loc:LocSource.Instance}}" Foreground="#6B7280" FontSize="12" />
                    <ComboBox x:Name="DiskCombo" Width="200" Margin="0,6,0,0"
                              DisplayMemberPath="DisplayName" SelectionChanged="OnDiskChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BusyText" Text="--" FontSize="40" FontWeight="SemiBold" Foreground="#1F2937" />
                        <TextBlock Text="{Binding [LabelDiskBusy], Source={x:Static loc:LocSource.Instance}}" Margin="10,0,0,8" Foreground="#6B7280" VerticalAlignment="Bottom" />
                        <Border x:Name="StateBadge" Margin="24,0,0,10" Padding="10,4" CornerRadius="12" Background="#E8F1FF" VerticalAlignment="Bottom">
                            <TextBlock x:Name="StateText" Text="{Binding [StateMonitoring], Source={x:Static loc:LocSource.Instance}}" Foreground="#1D4ED8" />
                        </Border>
                    </StackPanel>
                    <ProgressBar x:Name="BusyBar" Height="10" Margin="0,6,120,0" Maximum="100" Foreground="#2563EB" Background="#E5E7EB" />
                    <TextBlock x:Name="DetailText" Margin="0,8,0,0" Foreground="#6B7280" Text="--" />
                    <TextBlock x:Name="SystemDiagnosisText" Margin="0,5,0,0" Foreground="#92400E" Text="--" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="290">
                    <TextBlock x:Name="TargetText" Text="{Binding [TargetNone], Source={x:Static loc:LocSource.Instance}}" Foreground="#374151" TextAlignment="Right" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="PauseButton" Content="{Binding [BtnPauseMonitor], Source={x:Static loc:LocSource.Instance}}" Width="140" Height="30" Click="OnPauseClicked" />
                        <Button Content="{Binding [BtnReleaseNow], Source={x:Static loc:LocSource.Instance}}" Width="140" Height="30" Margin="8,0,0,0" Click="OnReleaseClicked" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="14,5">
            <TextBlock x:Name="SourceDetailsText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="400" />
            <Button Content="{Binding [BtnRetrySource], Source={x:Static loc:LocSource.Instance}}" Click="OnRetrySourceClicked" Margin="8,0" />
            <Button Content="{Binding [BtnExportDiagnostics], Source={x:Static loc:LocSource.Instance}}" Click="OnExportDiagnosticsClicked" />
        </StackPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="#EDF0F6" BorderBrush="#E3E7EF" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#6B7280" Margin="12,0,0,0" />
                <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="{Binding [BtnRestartElevated], Source={x:Static loc:LocSource.Instance}}" Padding="8,2" Margin="12,4,0,4"
                        VerticalAlignment="Center" Click="OnElevateClicked" />
                <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="{Binding [BtnOpenConfigDir], Source={x:Static loc:LocSource.Instance}}" Padding="8,2" Margin="12,4,0,4"
                        VerticalAlignment="Center" Click="OnOpenFolderClicked" />
                <TextBlock x:Name="PrivilegeText" VerticalAlignment="Center" Foreground="#4B5563" Text="--" />
            </DockPanel>
        </Border>

        <TabControl Margin="14,12,14,12">
            <TabItem Header="{Binding [TabProcess], Source={x:Static loc:LocSource.Instance}}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,4,0,8" Foreground="#6B7280"
                               Text="{Binding [HintProcessList], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" />

                    <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="28"
                              Background="White" BorderBrush="#E3E7EF" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [ColProcess], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding Name}" Width="230" />
                            <DataGridTextColumn Header="{Binding [ColPid], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding Pid}" Width="80" />
                            <DataGridTextColumn Header="{Binding [ColOccupancy], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding OccupancyText}" Width="100" />
                            <DataGridTextColumn Header="{Binding [ColTotal], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding RateText}" Width="120" />
                            <DataGridTextColumn Header="{Binding [ColRead], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding ReadText}" Width="120" />
                            <DataGridTextColumn Header="{Binding [ColWrite], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding WriteText}" Width="120" />
                            <DataGridTextColumn Header="{Binding [ColStatus], Source={x:Static loc:LocSource.Instance}}" Binding="{Binding Tag}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [BtnThrottleSelected], Source={x:Static loc:LocSource.Instance}}" Click="OnManualThrottleClicked" />
                        <Button Content="{Binding [BtnReleaseCurrent], Source={x:Static loc:LocSource.Instance}}" Margin="8,0,0,0" Click="OnReleaseClicked" />
                        <Button Content="{Binding [BtnAddWhitelist], Source={x:Static loc:LocSource.Instance}}" Margin="8,0,0,0" Click="OnWhitelistAddClicked" />
                        <Button Content="{Binding [BtnRemoveWhitelist], Source={x:Static loc:LocSource.Instance}}" Margin="8,0,0,0" Click="OnWhitelistRemoveClicked" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [TabSettings], Source={x:Static loc:LocSource.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardInterface], Source={x:Static loc:LocSource.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelLanguage], Source={x:Static loc:LocSource.Instance}}" />
                                    <ComboBox x:Name="LanguageCombo" Width="200"
                                              ItemsSource="{Binding Settings.Languages}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding Settings.Language, Mode=TwoWay}"
                                              SelectionChanged="OnLanguageChanged" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                               Text="{Binding [HintInterface], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardTrigger], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                           Text="{Binding [HintTrigger], Source={x:Static loc:LocSource.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelTriggerPercent], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelTriggerSeconds], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelRecoverPercent], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.RecoverPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelRecoverSeconds], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.RecoverSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelTriggerOccupancy], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.TriggerOccupancyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                               Text="{Binding [HintTriggerOccupancy], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelTargetOccupancy], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.TargetOccupancyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                               Text="{Binding [HintTargetOccupancy], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelMinIops], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.MinIops, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                               Text="{Binding [HintMinIops], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>

                                <Grid Margin="0,10,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="#374151" Text="{Binding [LabelEmergency], Source={x:Static loc:LocSource.Instance}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBox Width="70" Text="{Binding Settings.EmergencyPercent, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                                       Text="{Binding [HintEmergency], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="500" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Settings.EnableEmergencyThrottle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardThrottle], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.LowerIoPriority}"
                                          Content="{Binding [LabelLowerIoPriority], Source={x:Static loc:LocSource.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,5">
                                    <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="{Binding [LabelLevel], Source={x:Static loc:LocSource.Instance}}" />
                                    <ComboBox Width="150" Margin="10,0,0,0" SelectedIndex="{Binding Settings.IoPriorityLevel}">
                                        <ComboBoxItem Content="{Binding [OptionVeryLow], Source={x:Static loc:LocSource.Instance}}" />
                                        <ComboBoxItem Content="{Binding [OptionLow], Source={x:Static loc:LocSource.Instance}}" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.LowerCpuPriority}"
                                          Content="{Binding [LabelLowerCpuPriority], Source={x:Static loc:LocSource.Instance}}" />

                                <Grid Margin="8,8,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="#374151" Text="{Binding [LabelEnableRateCap], Source={x:Static loc:LocSource.Instance}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="{Binding [LabelCapValue], Source={x:Static loc:LocSource.Instance}}" />
                                            <TextBox Width="90" Margin="10,0,0,0" Text="{Binding Settings.RateCapMBps, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.EnableRateCap}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="8,8,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [LabelEscalate], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBox Width="90" Text="{Binding Settings.EscalateSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF"
                                               Text="{Binding [HintEscalate], Source={x:Static loc:LocSource.Instance}}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>

                                <Grid Margin="8,8,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="#374151" Text="{Binding [LabelSuspendMode], Source={x:Static loc:LocSource.Instance}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="{Binding [LabelSuspendRun], Source={x:Static loc:LocSource.Instance}}" />
                                            <TextBox Width="70" Margin="8,0,0,0" Text="{Binding Settings.SuspendRunMs, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" Text="{Binding [LabelSuspendPause], Source={x:Static loc:LocSource.Instance}}" />
                                            <TextBox Width="70" Margin="8,0,0,0" Text="{Binding Settings.SuspendPauseMs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.EnableSuspendMode}" />
                                </Grid>
                                <TextBlock Margin="8,2,0,0" Foreground="#B45309" TextWrapping="Wrap"
                                           Text="{Binding [HintSuspendWarning], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardProtection], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.ProtectForeground}"
                                          Content="{Binding [LabelProtectForeground], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="8,4,0,2" Foreground="#9CA3AF" TextWrapping="Wrap"
                                           Text="{Binding [HintProtectForeground], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="8,10,0,4" Foreground="#374151" TextWrapping="Wrap"
                                           Text="{Binding [LabelWhitelist], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBox Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Settings.WhitelistText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardBehavior], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleRow}"
                                          IsChecked="{Binding Settings.AutoStart}" Click="OnAutoStartClicked"
                                          Content="{Binding [LabelAutoStart], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="8,0,0,4" Foreground="#9CA3AF" TextWrapping="Wrap"
                                           Text="{Binding [HintAutoStart], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.StartMinimized}"
                                          Content="{Binding [LabelStartMinimized], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.WriteLogFile}"
                                          Content="{Binding [LabelWriteLog], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding Settings.ShowBalloon}"
                                          Content="{Binding [LabelShowBalloon], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardDeveloper], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="DeveloperModeCheck" Style="{StaticResource ToggleRow}"
                                          IsChecked="{Binding Settings.DeveloperMode}" Click="OnDeveloperModeClicked"
                                          Content="{Binding [LabelDeveloperMode], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="8,6,0,10" Foreground="#6B7280" TextWrapping="Wrap"
                                           Text="{Binding [HintDeveloperMode], Source={x:Static loc:LocSource.Instance}}" />
                                <WrapPanel>
                                    <Button Content="{Binding [BtnViewDeveloperLog], Source={x:Static loc:LocSource.Instance}}" Click="OnViewDeveloperLogClicked" />
                                    <Button Content="{Binding [BtnOpenDeveloperLogFolder], Source={x:Static loc:LocSource.Instance}}" Margin="10,0,0,0"
                                            Click="OnOpenDeveloperLogFolderClicked" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardDefender], Source={x:Static loc:LocSource.Instance}}" />
                                    <Button x:Name="RefreshDefenderButton" Grid.Column="1" Style="{StaticResource CompactButton}"
                                            Content="{Binding [BtnRefreshStatus], Source={x:Static loc:LocSource.Instance}}"
                                            Click="OnRefreshSystemControlsClicked" />
                                </Grid>
                                <TextBlock x:Name="DefenderStatusText" Margin="0,0,0,4" Foreground="#6B7280" Text="--" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                           Text="{Binding [HintDefender], Source={x:Static loc:LocSource.Instance}}" />

                                <CheckBox x:Name="DefenderRealtimeCheck" Style="{StaticResource ToggleRow}"
                                          Click="OnDefenderRealtimeClicked"
                                          Content="{Binding [LabelDefenderRealtime], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="DefenderLowCpuCheck" Style="{StaticResource ToggleRow}"
                                          Click="OnDefenderLowCpuClicked"
                                          Content="{Binding [LabelDefenderLowCpu], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="DefenderIdleScanCheck" Style="{StaticResource ToggleRow}"
                                          Click="OnDefenderIdleScanClicked"
                                          Content="{Binding [LabelDefenderIdleScan], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="DefenderScheduledScanCheck" Style="{StaticResource ToggleRow}"
                                          Click="OnDefenderScheduledScanClicked"
                                          Content="{Binding [LabelDefenderScheduledScan], Source={x:Static loc:LocSource.Instance}}" />

                                <Grid Margin="8,7,8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#374151"
                                               Text="{Binding [LabelDefenderCpuLimit], Source={x:Static loc:LocSource.Instance}}" />
                                    <ComboBox x:Name="DefenderCpuLimitCombo" Grid.Column="1" Width="96"
                                              SelectionChanged="OnDefenderCpuLimitChanged">
                                        <ComboBoxItem Content="20%" />
                                        <ComboBoxItem Content="30%" />
                                        <ComboBoxItem Content="50%" />
                                        <ComboBoxItem Content="70%" />
                                        <ComboBoxItem Content="100%" />
                                    </ComboBox>
                                </Grid>
                                <Button x:Name="DefenderLowImpactButton" HorizontalAlignment="Left" Margin="8,8,0,2"
                                        Content="{Binding [BtnDefenderLowImpact], Source={x:Static loc:LocSource.Instance}}"
                                        Click="OnApplyDefenderLowImpactClicked" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardMaintenance], Source={x:Static loc:LocSource.Instance}}" />
                                    <Button x:Name="RefreshServicesButton" Grid.Column="1" Style="{StaticResource CompactButton}"
                                            Content="{Binding [BtnRefreshStatus], Source={x:Static loc:LocSource.Instance}}"
                                            Click="OnRefreshSystemControlsClicked" />
                                </Grid>
                                <TextBlock x:Name="SystemControlsStatusText" Margin="0,0,0,4" Foreground="#6B7280" Text="--" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,7"
                                           Text="{Binding [HintMaintenance], Source={x:Static loc:LocSource.Instance}}" />

                                <CheckBox x:Name="StopSysMainCheck" Tag="SysMain" Style="{StaticResource ToggleRow}"
                                          Click="OnServiceToggleClicked"
                                          Content="{Binding [LabelSysMain], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="StopWSearchCheck" Tag="WSearch" Style="{StaticResource ToggleRow}"
                                          Click="OnServiceToggleClicked"
                                          Content="{Binding [LabelSearchIndex], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="StopDoSvcCheck" Tag="DoSvc" Style="{StaticResource ToggleRow}"
                                          Click="OnServiceToggleClicked"
                                          Content="{Binding [LabelDeliveryOptimization], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="StopWuauservCheck" Tag="wuauserv" Style="{StaticResource ToggleRow}"
                                          Click="OnServiceToggleClicked"
                                          Content="{Binding [LabelWindowsUpdate], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="StopBitsCheck" Tag="BITS" Style="{StaticResource ToggleRow}"
                                          Click="OnServiceToggleClicked"
                                          Content="{Binding [LabelBits], Source={x:Static loc:LocSource.Instance}}" />
                                <CheckBox x:Name="ScheduledDefragCheck" Style="{StaticResource ToggleRow}" Margin="0,6,0,1"
                                          Click="OnScheduledDefragToggleClicked"
                                          Content="{Binding [LabelScheduledDefrag], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="8,4,0,0" Foreground="#9CA3AF" TextWrapping="Wrap"
                                           Text="{Binding [HintServiceToggles], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Style="{StaticResource PrimaryButton}" Padding="20,7"
                                    Content="{Binding [BtnSaveSettings], Source={x:Static loc:LocSource.Instance}}"
                                    Click="OnSaveSettingsClicked" />
                            <Button Content="{Binding [BtnResetSettings], Source={x:Static loc:LocSource.Instance}}" Margin="10,0,0,0"
                                    Click="OnResetSettingsClicked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding [TabLog], Source={x:Static loc:LocSource.Instance}}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="LogList" Grid.Row="0" ItemsSource="{Binding Logs}" Background="White"
                              BorderBrush="#E3E7EF" BorderThickness="1"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding [ColLogTime], Source={x:Static loc:LocSource.Instance}}" Width="90" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="{Binding [ColLogLevel], Source={x:Static loc:LocSource.Instance}}" Width="70" DisplayMemberBinding="{Binding Level}" />
                                <GridViewColumn Header="{Binding [ColLogMessage], Source={x:Static loc:LocSource.Instance}}" Width="800">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [BtnClearLog], Source={x:Static loc:LocSource.Instance}}" Click="OnClearLogClicked" />
                        <Button Content="{Binding [BtnOpenLogDir], Source={x:Static loc:LocSource.Instance}}" Margin="8,0,0,0" Click="OnOpenFolderClicked" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [TabAbout], Source={x:Static loc:LocSource.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,4,4,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [AboutTitle], Source={x:Static loc:LocSource.Instance}}" FontSize="20" FontWeight="SemiBold" Foreground="#111827" />
                                <TextBlock x:Name="AboutVersionText" Margin="0,6,0,0" Foreground="#6B7280" Text="--" />
                                <TextBlock Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding [AboutByAuthor], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#4B5563"
                                           Text="{Binding [AboutSummaryLine1], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#6B7280"
                                           Text="{Binding [AboutSummaryLine2], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardAuthor], Source={x:Static loc:LocSource.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="110" Text="{Binding [LabelAuthor], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding [AuthorName], Source={x:Static loc:LocSource.Instance}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="110" Text="{Binding [LabelDouyin], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBlock x:Name="DouyinText" VerticalAlignment="Center" Foreground="#111827" Text="XRuiiiiii" />
                                    <Button Content="{Binding [BtnCopy], Source={x:Static loc:LocSource.Instance}}" Margin="12,0,0,0" Padding="12,2" Click="OnCopyDouyinClicked" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="110" Text="{Binding [LabelXiaohongshu], Source={x:Static loc:LocSource.Instance}}" />
                                    <TextBlock x:Name="XiaohongshuText" VerticalAlignment="Center" Foreground="#111827" Text="xiaoruiaaa520" />
                                    <Button Content="{Binding [BtnCopy], Source={x:Static loc:LocSource.Instance}}" Margin="12,0,0,0" Padding="12,2" Click="OnCopyXiaohongshuClicked" />
                                </StackPanel>
                                <TextBlock x:Name="AboutCopyHint" Margin="0,10,0,0" Foreground="#059669" Text="" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6B7280"
                                           Text="{Binding [HintContactAuthor], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardOpenSource], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock TextWrapping="Wrap" Foreground="#374151" Text="{Binding [OpenSourceText], Source={x:Static loc:LocSource.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ProjectHomeButton" Content="{Binding [BtnOpenProjectHome], Source={x:Static loc:LocSource.Instance}}" Click="OnOpenProjectHomeClicked" Visibility="Collapsed" />
                                    <Button Content="{Binding [BtnOpenConfigDir], Source={x:Static loc:LocSource.Instance}}" Margin="8,0,0,0" Click="OnOpenFolderClicked" />
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#4B5563"
                                           Text="{Binding [ThirdPartyText], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [CardDisclaimer], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock TextWrapping="Wrap" Foreground="#374151" Text="{Binding [DisclaimerText1], Source={x:Static loc:LocSource.Instance}}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#374151" Text="{Binding [DisclaimerText2], Source={x:Static loc:LocSource.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
